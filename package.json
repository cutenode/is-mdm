{
	"name": "is-mdm",
	"version": "0.0.3",
	"main": "isMdm.cjs",
	"module": "isMdm.mjs",
	"exports": {
		".": {
			"import": "./isMdm.mjs",
			"require": "./isMdm.cjs",
			"default": "./isMdm.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"isMdm.cjs",
		"isMdm.mjs"
	],
	"scripts": {
		"check": "biome check",
		"format": "npx @biomejs/biome format",
		"format:write": "npx @biomejs/biome format --write",
		"test": "node --test",
		"coverage": "c8 node --test"
	},
	"keywords": [
		"mdm"
	],
	"author": "Tierney Cyren <hello@bnb.im>",
	"license": "MIT",
	"description": "is-mdm allows for quick, zero dependency checking of whether or not the device it is run on is a managed device.",
	"devDependencies": {
		"@biomejs/biome": "2.3.2",
		"c8": "^12.0.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cutenode/is-mdm.git"
	},
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/cutenode/is-mdm/issues"
	},
	"homepage": "https://github.com/cutenode/is-mdm#readme"
}
